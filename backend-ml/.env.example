# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prices_db
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# API Security
# IMPORTANT: Change this to a strong secret key in production
API_KEY=your-secret-api-key-change-this-in-production

# Model Artifacts Directory
# Path to folder containing model files (scalers.pkl, feature_cols.pkl, best_lstm.pth, etc.)
MODELS_DIR=./models

# Logging Level
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Optional: Server Configuration
# HOST=0.0.0.0
# PORT=8000
# WORKERS=4
