# FastAPI Server Configuration
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001

# PostgreSQL Database Configuration (for Docker: use host.docker.internal to reach Mac's localhost)
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=ai_price_monitor
DB_USER=price_monitor_user
DB_PASSWORD=mypassword
DATABASE_URL=postgresql://price_monitor_user:mypassword@host.docker.internal:5432/ai_price_monitor

# Models Directory
MODELS_DIR=./models

# API Key for Spring Boot Authentication
# Spring Boot must send this in the X-API-Key header with every request
API_KEY=your-secret-key-change-this-in-production
